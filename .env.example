# Home server deployment defaults
# These URLs assume this dashboard runs directly on the homelab at 10.0.0.223.
# If its LAN address changes, replace 10.0.0.223 everywhere in this file and in
# frontend/.env.local.example before building the frontend.

# Backend
PORT=4000
FRONTEND_ORIGIN=http://10.0.0.223:3000,http://localhost:3000
UPDATE_TIMEOUT_MS=3600000
# Logs are written to stdout; with systemd, view them with journalctl (see README).

# Integrations (point at LAN / Docker host addresses on the homeserver)
NETDATA_URL=http://127.0.0.1:19999

# Pi-hole is published by this homelab on port 8080.
PIHOLE_URL=http://127.0.0.1:8080
PIHOLE_PASSWORD=
# Optional legacy token fallback
PIHOLE_API_TOKEN=

# qBittorrent is published by this homelab on port 8181.
QBITTORRENT_URL=http://127.0.0.1:8181
QBITTORRENT_USER=admin
QBITTORRENT_PASS=

SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=

RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=

# App quick-link tiles (leave blank to hide)
APP_FILES_URL=
APP_ACTUAL_BUDGET_URL=
APP_OLLAMA_URL=http://10.0.0.223:11434
APP_SEARXNG_URL=
APP_SONARR_URL=http://10.0.0.223:8989
APP_DOZZLE_URL=
APP_OPEN_WEBUI_URL=
APP_PIHOLE_URL=http://10.0.0.223:8080
APP_PLEX_URL=
APP_IMMICH_URL=
APP_RADARR_URL=http://10.0.0.223:7878
APP_QBITTORRENT_URL=http://10.0.0.223:8181
APP_NETDATA_URL=http://10.0.0.223:19999
APP_SYNCTHING_URL=
APP_TURBODIFFUSION_URL=
APP_CASAOS_APP_STORE_URL=http://10.0.0.223/#/appstore

# The frontend's build-time setting belongs in frontend/.env.local.
# Copy frontend/.env.local.example there before running npm run build.
