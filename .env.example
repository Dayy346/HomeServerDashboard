# Backend
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
UPDATE_TIMEOUT_MS=3600000
# Logs are written to stdout; with systemd, view them with journalctl (see README).

# Integrations (point at LAN / Docker host addresses on the homeserver)
NETDATA_URL=http://127.0.0.1:19999

# Pi-hole is published by this homelab on port 8080.
PIHOLE_URL=http://127.0.0.1:8080
PIHOLE_PASSWORD=
# Optional legacy token fallback
PIHOLE_API_TOKEN=

# qBittorrent is published by this homelab on port 8181.
QBITTORRENT_URL=http://127.0.0.1:8181
QBITTORRENT_USER=admin
QBITTORRENT_PASS=

SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=

RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=

# App quick-link tiles (leave blank to hide)
APP_FILES_URL=
APP_ACTUAL_BUDGET_URL=
APP_OLLAMA_URL=
APP_SEARXNG_URL=
APP_SONARR_URL=
APP_DOZZLE_URL=
APP_OPEN_WEBUI_URL=
APP_PIHOLE_URL=
APP_PLEX_URL=
APP_IMMICH_URL=
APP_RADARR_URL=
APP_QBITTORRENT_URL=
APP_NETDATA_URL=
APP_SYNCTHING_URL=
APP_TURBODIFFUSION_URL=

# Frontend (build-time public URL of the backend)
NEXT_PUBLIC_API_URL=http://localhost:4000
